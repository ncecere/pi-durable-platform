# Local development. Copy to .env: `cp .env.example .env` (`make run` does it
# for you), then `make run`.
# These values only work with a loopback APP_URL: Pi Durable Platform refuses
# to start on any other APP_URL with the example ENCRYPTION_KEY or
# API_KEY_PEPPER below, with DEV_AUTH=true, or with an http:// APP_URL.
# `pi-durable-platform doctor` checks the configuration, Postgres and migrations.
#
# Every setting the platform reads is listed here, active or commented out with
# its default. Settings that hold a secret (DATABASE_URL, the keys, OIDC_CLIENT_SECRET,
# AGENTS_DATABASE_URL, AGENTS_MODEL_API_KEY, AGENTS_SANDBOX_ACTIVATION_TOKEN) can also be
# read from a file with NAME_FILE=/path (how Kubernetes Secrets are mounted).
# A YAML file can replace or add to these: set PDP_CONFIG_FILE; its keys are the
# lower-case names (app_url: https://...), and the environment wins over the file.
# PDP_CONFIG_FILE=/etc/pi-durable-platform/config.yaml
APP_URL=http://localhost:8098
LISTEN_ADDR=127.0.0.1:8098
DATABASE_URL=postgres://pdp:pdp-local-only@127.0.0.1:55432/pdp?sslmode=disable
MIGRATE_ON_START=true
LOG_FORMAT=text
LOG_LEVEL=debug
# On shutdown, readiness fails first and the process waits SHUTDOWN_DELAY (default 5s) for
# the load balancer to stop sending traffic, then gives in-flight requests SHUTDOWN_TIMEOUT
# (default 60s) to finish.
# Here 0s, so stopping a local instance is quick (a deployment keeps the default, or sets it to what its load balancer needs).
SHUTDOWN_DELAY=0s
# SHUTDOWN_TIMEOUT=60s

# Encrypts secrets stored in the database (internal/secrets): model provider keys and
# headers, MCP server headers, and each agent's database password and runtime token.
# Development-only value, refused off loopback; generate your own with:
# openssl rand -base64 32
ENCRYPTION_KEY=IxrMu3wRv8auVYRSrLxAwRE3LhN6dgJeB9CEZ5m6Xvg=
# Rotation: the old key, still accepted to read values sealed with it. Put the new key in
# ENCRYPTION_KEY, the old one here, restart, run `pi-durable-platform rekey` (re-seals every
# value under the new key), check `pi-durable-platform doctor` reports nothing under the
# previous key, then remove this line.
# ENCRYPTION_KEY_PREVIOUS=

# Keys the HMAC under which personal API keys, service account keys, and OAuth
# Connect tokens and codes are stored (only digests are kept). Development-only
# value, refused off loopback; generate your own with openssl rand -base64 32.
# Changing it invalidates all of them unless the old value is kept as
# API_KEY_PEPPER_PREVIOUS for a while.
API_KEY_PEPPER=Ds2SKp4FFD5yz6wtk2Xfik5cnwE05zCSj16UAEH/0mc=
# Rotation: the old pepper. Keys, tokens and codes made with it keep working (they are
# re-digested on use); remove it after 2-4 weeks.
# API_KEY_PEPPER_PREVIOUS=

# Local-only sign-in with fixed personas: admin (platform admin), auditor
# (platform auditor), and user, alex, blair and casey (no platform role).
# Refused unless APP_URL is loopback. Never enable on a reachable host.
DEV_AUTH=true

# Instance identity. Nothing in the product names an organisation; each
# deployment sets its own.
# INSTANCE_NAME="Pi Durable Platform"  # product name in the UI and page titles
# ORG_NAME=                            # e.g. "Example Corp"
# UI_THEME=neutral                     # neutral (the only theme)
# UI_LOGO_URL=                         # https URL or same-origin path, e.g. https://www.example.com/logo.svg
# SUPPORT_URL=                         # "Help" link: http(s) URL or mailto: address

# Where people request a team (for example a service desk request form).
# TEAM_REQUEST_URL=https://help.example.com/new-team

# Sessions and limits (defaults shown). Counted in PostgreSQL, shared by
# every replica.
# SESSION_TTL=12h
# REQUESTS_PER_MINUTE=600
# LOGIN_ATTEMPTS_PER_MINUTE=20
# TRUSTED_PROXIES=                  # ingress CIDRs allowed to set X-Forwarded-For, e.g. 10.0.0.0/8

# Real single sign-on (any OIDC provider). Leave OIDC_ISSUER empty to disable.
# OIDC_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=               # or OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# Add offline_access to re-check groups while people are signed in (see
# OIDC_ALLOWED_GROUPS): the provider must issue refresh tokens for this client
# (authentik: enable the "offline_access" scope mapping on the provider).
# OIDC_SCOPES=openid,profile,email
# OIDC_EMAIL_CLAIM=email
# OIDC_GROUPS_CLAIM=groups            # the claim with the person's groups; empty: none
# OIDC_REQUIRE_VERIFIED_EMAIL=true
# OIDC_ALLOWED_EMAIL_DOMAINS=example.com   # empty: anyone the provider signs in
# Only people in one of these IdP groups (OIDC_GROUPS_CLAIM) may sign in; the
# bootstrap admin always may. Empty: no group is required.
# OIDC_ALLOWED_GROUPS=pi-durable-users,pi-durable-admins
# With OIDC_ALLOWED_GROUPS and the offline_access scope, how often the provider
# is asked whether each recently active person is still in an allowed group (the
# bootstrap admin is exempt). Someone no longer in one, or whom the provider
# refuses to vouch for, loses their sessions and connected apps, and their API
# keys stop working, until they sign in again (their data and teams stay). 0
# turns the re-check off.
# OIDC_GROUP_RECHECK_INTERVAL=15m
# People keep access this long while the provider can't be asked (it is
# unreachable, or its answer lacks the groups claim), counted from its last
# answer. At least the interval.
# OIDC_GROUP_RECHECK_GRACE=24h
# The OIDC subject made platform admin on its first sign-in (once; a later
# demotion is not undone by signing in again).
# BOOTSTRAP_ADMIN_SUBJECT=

# Agents. Each agent keeps its state in its own schema and database role in
# AGENTS_DATABASE_URL's database (separate from DATABASE_URL's). The role in
# that URL needs CREATEROLE and CREATE on the database; agents never get it.
# AGENTS_CREATE_DATABASE creates the database at start-up (development only).
AGENTS_DATABASE_URL=postgres://pdp:pdp-local-only@127.0.0.1:55432/pdp_agents?sslmode=disable
AGENTS_CREATE_DATABASE=true
# host:port that agent runtimes use to reach the agents database, when it differs from the
# one in AGENTS_DATABASE_URL (the platform and the agents see PostgreSQL at different
# addresses). Empty: the host in AGENTS_DATABASE_URL.
# AGENTS_RUNTIME_DATABASE_HOST=
# local: agents run as child processes of the platform (development; needs
# `pnpm install` in runtime/). kubernetes: one pod per agent (AGENTS_IMAGE).
# agent-sandbox: Kubernetes Agent Sandbox; a Sandbox per agent, suspended when
# idle (AGENTS_IMAGE), or claims on a SandboxWarmPool of standby runtimes
# (AGENTS_SANDBOX_WARM_POOL, AGENTS_SANDBOX_ACTIVATION_SECRET). See DESIGN.md.
AGENTS_LAUNCHER=local
AGENTS_RUNTIME_DIR=runtime
# kubernetes and agent-sandbox launchers: the runtime image (required for kubernetes, and for
# agent-sandbox without a warm pool), the namespace for agent pods (empty: the platform's own),
# an optional RuntimeClass such as gvisor, and an optional image pull Secret in that namespace.
# AGENTS_IMAGE=registry.example.com/pdp-runtime:<version>
# AGENTS_NAMESPACE=
# AGENTS_RUNTIME_CLASS=
# AGENTS_IMAGE_PULL_SECRET=
# agent-sandbox with a SandboxWarmPool (in AGENTS_NAMESPACE): claim standby runtimes from it.
# They are activated with the pool's RUNTIME_ACTIVATION_TOKEN, given either as the name of a
# Secret the platform keeps it in (created if missing) or as the token itself (at least 32
# characters; or AGENTS_SANDBOX_ACTIVATION_TOKEN_FILE). Set one of the two, not both.
# AGENTS_SANDBOX_WARM_POOL=
# AGENTS_SANDBOX_ACTIVATION_SECRET=pdp-activation
# AGENTS_SANDBOX_ACTIVATION_TOKEN=
# Idle agents hibernate after this long; the next request wakes them.
AGENTS_IDLE_TIMEOUT=10m
# Background work (background tasks and subagents, tool calls still running
# after their reply) keeps an agent awake for at most this long: older work is
# aborted and the agent may hibernate (docs/hibernation.md). 1m to 168h.
AGENTS_BACKGROUND_MAX=2h
# Triggers (schedules and webhooks that start runs; docs/triggers.md). How often
# each replica's trigger loop runs (one replica at a time does the work), and the
# ceilings of every agent's limits: the longest a triggered run may take, the most
# triggered runs an agent may have at once (an agent's default is 1), and the
# failed runs in a row after which a trigger pauses itself.
# TRIGGERS_INTERVAL=10s
# TRIGGERS_MAX_RUN_TIME=30m
# TRIGGERS_MAX_CONCURRENT_RUNS=5
# TRIGGERS_PAUSE_AFTER_FAILURES=5
# The platform's default model, for templates and agents that don't choose one
# from the model catalog (Admin > Models). demo: a scripted model, no key
# needed. openai-compatible: LiteLLM, vLLM, …
AGENTS_MODEL_PROVIDER=demo
# AGENTS_MODEL_BASE_URL=https://litellm.example.com/v1
# AGENTS_MODEL_API_KEY=
# AGENTS_MODEL_ID=
# Marks the default model as a reasoning model (openai-compatible only).
# AGENTS_MODEL_REASONING=false

# Observability (DESIGN.md, Observability).
# Prometheus metrics: the address of a listener that serves /metrics and
# nothing else (no authentication: bind it to a private interface, never put
# it behind an Ingress; the Helm chart sets :9090 and a NetworkPolicy for the
# scraper). Empty: no metrics endpoint.
# METRICS_ADDR=127.0.0.1:9090
# OpenTelemetry traces, off unless this is set: the base URL of an OTLP/HTTP
# collector (port 4318, not gRPC), for example http://otel-collector:4318.
# Spans are named by route pattern and hold no message content, headers,
# URLs or secrets. The exporter itself also honours the standard variables
# for its headers (authentication), timeout, compression and TLS certificates
# (OTEL_EXPORTER_OTLP_HEADERS and its siblings): set those in the process
# environment, from a Secret, not here.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_SERVICE_NAME=pi-durable-platform
# The share of new traces kept, 0 to 1. It decides every request: a traceparent
# (or sampled flag) a client sends does not force a trace.
# OTEL_TRACES_SAMPLER_ARG=1

# The gateway agents call for models of proxy-mode providers: where the
# platform listens for agents, and the URL agents use to reach it (on
# Kubernetes, the platform Service's name and gateway port).
AGENTS_GATEWAY_ADDR=127.0.0.1:8099
AGENTS_GATEWAY_URL=http://127.0.0.1:8099
# MCP servers apps may give agents for a thread (a chat app's servers its
# user enabled): comma-separated [scheme://]host[:port] ("*." for subdomains,
# https by default; empty: none), and whether agents reach them through the
# gateway (proxy) or directly.
# AGENTS_CLIENT_MCP_HOSTS=mcp.example.com,*.tools.example.com
AGENTS_CLIENT_MCP_MODE=proxy
